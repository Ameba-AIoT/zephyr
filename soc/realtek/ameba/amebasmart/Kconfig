config SOC_RTL8730E_CA32
	select ARM
	select CPU_CORTEX_A32
	select ARM_ARCH_TIMER
	select CPU_HAS_FPU
	select FPU
	select HAS_PM

# KM4 — MCUboot bootloader domain
config SOC_RTL8730E_KM4
	select ARM
	select CPU_CORTEX_M55
	select ARMV8_M_DSP
	select CPU_HAS_ARM_MPU
	select ARM_MPU
	select CPU_HAS_ARM_SAU
	select CPU_HAS_FPU
	select CPU_HAS_VFP
	select DYNAMIC_INTERRUPTS
