# Realtek AMEBA CAN configuration options
config CAN_AMEBA_CAN
	bool "Realtek CAN driver"
	default y
	depends on DT_HAS_REALTEK_AMEBA_CAN_ENABLED
	select CAN_SJA1000
	select PINCTRL
	help
	  This enables support for the Realtek Controller Area Network  (CAN)
	  driver.
