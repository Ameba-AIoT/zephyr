# Configurations here work for all rtl8730e_evb variants

ZEPHYR_USER := zephyr,user

# enable rcc
config CLOCK_CONTROL
	default y

# enable uart
config SERIAL
	default y

# enable console for stdout
config CONSOLE
	default y

config UART_CONSOLE
	default y

config GPIO
	default y

config NOCACHE_MEMORY
	default y

if BOARD_RTL8730E_EVB

# Default to SMP for the CA32 Zephyr app (dual Cortex-A32 cores).
# NOT set for the KM4 MCUboot domain (single-core Cortex-M55).
config SMP
	default y if SOC_RTL8730E_CA32 && USE_SWITCH

config USE_SWITCH
	default y if SOC_RTL8730E_CA32

# The non-USE_SWITCH FPU_SHARING path builds its exception frame, VFP
# registers included, on the UND/ABT mode stack, which overflows the default
# 256 B.  USE_SWITCH moves the frame to the SYS stack, so the default is
# enough there.
config ARMV7_EXCEPTION_STACK_SIZE
	default 1024 if FPU_SHARING && !USE_SWITCH

# With FPU_SHARING every exception frame carries the caller-saved VFP
# registers (232 B instead of 32 B) and is stacked on the interrupted
# thread's stack, so the default 320 B idle stack overflows on the first
# preemption from idle.
config IDLE_STACK_SIZE
	default 1024 if FPU_SHARING

endif # BOARD_RTL8730E_EVB

if MCUBOOT

config FLASH_BASE_ADDRESS
	hex
	default $(dt_node_int_prop_hex,/$(ZEPHYR_USER),flash-base-phy)

endif # MCUBOOT
