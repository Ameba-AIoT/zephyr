# Main board: CA32 Zephyr application domain.
# When the mcuboot variant is active, BOARD_RTL8730E_EVB_MCUBOOT is also y,
# so the CA32-only selects are guarded by !BOARD_RTL8730E_EVB_MCUBOOT.
config BOARD_RTL8730E_EVB
	bool "RTL8730E EVB Platform Board"
	select SOC_RTL8730E_CA32 if !BOARD_RTL8730E_EVB_RTL8730E_MCUBOOT
	select BUILD_WITH_TFA    if !BOARD_RTL8730E_EVB_RTL8730E_MCUBOOT

# MCUboot variant: KM4 (Cortex-M55) bootloader domain.
# Zephyr sets BOARD_<board>_<soc>_<qualifier> = BOARD_RTL8730E_EVB_RTL8730E_MCUBOOT
# when building with BOARD=rtl8730e_evb//mcuboot (board.yml soc=rtl8730e, variant=mcuboot).
config BOARD_RTL8730E_EVB_RTL8730E_MCUBOOT
	bool "RTL8730E EVB MCUboot variant (KM4)"
	select SOC_RTL8730E_KM4
